# Copy to backend/.env for local development.
# In production, set these as environment variables in your Render dashboard instead.

ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Leave both blank to use a local tasks.db file (local dev).
# Fill both in to use a hosted Turso database (production).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
